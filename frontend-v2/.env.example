# Frontend environment variables
# Copy to .env and update values

# ─── API Backend URL ───────────────────────────────────────
# Local dev:
PUBLIC_API_BASE_URL=http://localhost:8000/api
# Production (update after Render deploy):
# PUBLIC_API_BASE_URL=https://swasthatrack-api.onrender.com/api

# ─── Site URL (for sitemap, canonical URLs, OG tags) ──────
# Local dev:
SITE_URL=http://localhost:4321
# Production:
# SITE_URL=https://swasthatrack.vercel.app

# ─── Google OAuth ──────────────────────────────────────────
# Google Client ID from Google Cloud Console (OAuth 2.0 Web Application)
PUBLIC_GOOGLE_CLIENT_ID=
