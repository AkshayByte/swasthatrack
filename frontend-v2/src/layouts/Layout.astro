---
import '../styles/global.css';
import StaffAuthButton from '../components/react/StaffAuthButton';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SwasthaTrack - Smart Healthcare Management & AI Triage',
  description = 'Next-generation patient triage and hospital operations platform certified for Ayushman Bharat Digital Mission (ABDM).'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Google Analytics Placeholder -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SWSTHATRK0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SWSTHATRK0');
    </script>

    <!-- Immediate Theme Initialization (Prevents FOUC) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-white bg-slate-50 dark:bg-[#070b14] text-slate-900 dark:text-slate-100 transition-colors duration-300">
    <!-- Global Header / Navbar -->
    <header class="sticky top-0 z-50 w-full border-b border-slate-200/90 dark:border-slate-800/80 bg-white/90 dark:bg-[#0d1527]/90 backdrop-blur-md transition-colors duration-300 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-600 via-sky-600 to-blue-600 flex items-center justify-center text-white font-black text-xl shadow-md group-hover:shadow-cyan-500/30 group-hover:scale-105 transition-all">
            ST
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-lg text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              SwasthaTrack
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 font-bold border border-cyan-300 dark:border-cyan-800">
                ABDM Verified
              </span>
            </span>
            <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">Intelligent Healthcare & Hospital Operations</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Home</a>
          <a href="/#features" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Hospital Portals</a>
          <a href="/#how-it-works" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">How It Works</a>
          <a href="/about" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">About Us</a>
          <a href="/contact" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Support & Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800/90 text-slate-700 dark:text-amber-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500 shadow-sm cursor-pointer"
            aria-label="Toggle visual theme"
            title="Toggle Light / Dark Mode"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="theme-toggle-light-icon" class="hidden w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Clinical Staff Auth Status Pill -->
          <StaffAuthButton client:load />

          <a
            href="/dashboard"
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-sm font-bold rounded-xl text-white bg-gradient-to-r from-cyan-600 via-sky-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 shadow-md hover:shadow-cyan-500/25 transition-all"
          >
            Launch Portals →
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- User-Centric Global Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800/80 bg-white dark:bg-[#090d18] transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
          
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white font-black text-sm">
                ST
              </div>
              <span class="font-extrabold text-slate-900 dark:text-white text-base">SwasthaTrack</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Transforming outpatient hospital care with intelligent clinical triage, digital health records, and zero-wait queue optimization under the Ayushman Bharat Digital Mission.
            </p>
            <div class="pt-2">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-md bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900">
                🛡️ ABDM & ABHA Compliant
              </span>
            </div>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3.5">Hospital Portals</h4>
            <ul class="space-y-2.5 text-xs font-medium text-slate-600 dark:text-slate-400">
              <li><a href="/dashboard/registration" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Patient Intake & AI Triage</a></li>
              <li><a href="/dashboard/doctor" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Doctor Clinical Suite</a></li>
              <li><a href="/dashboard/pharmacy" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Central Pharmacy Dispensation</a></li>
              <li><a href="/dashboard/lab" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Diagnostics & Pathology Lab</a></li>
              <li><a href="/dashboard/admin" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Hospital Administration</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3.5">For Healthcare Users</h4>
            <ul class="space-y-2.5 text-xs font-medium text-slate-600 dark:text-slate-400">
              <li><a href="/#how-it-works" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Emergency Triage Guide</a></li>
              <li><a href="/about" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Our Mission for Patients</a></li>
              <li><a href="/contact" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">24/7 Clinical Support</a></li>
              <li><a href="/#faq" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Patient FAQs</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3.5">Privacy & Helpline</h4>
            <ul class="space-y-2.5 text-xs font-medium text-slate-600 dark:text-slate-400">
              <li><a href="/privacy" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Patient Privacy & Data Protection</a></li>
              <li><a href="/terms" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Terms of Clinical Service</a></li>
              <li class="pt-2 text-slate-900 dark:text-slate-200 font-semibold">
                Toll-Free Hospital Helpline:
                <div class="text-cyan-600 dark:text-cyan-400 text-xs font-mono mt-0.5">1800-11-4477 (24/7 Care)</div>
              </li>
            </ul>
          </div>

        </div>

        <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-4">
          <p>© {new Date().getFullYear()} SwasthaTrack Healthcare Platform. Dedicated to accessible, queue-free healthcare for India.</p>
          <div class="flex items-center gap-2 font-medium">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-emerald-700 dark:text-emerald-400">Real-Time Clinical Network Active</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive Dark Mode Script -->
    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

      function updateIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          themeToggleLightIcon?.classList.remove('hidden');
          themeToggleDarkIcon?.classList.add('hidden');
        } else {
          themeToggleLightIcon?.classList.add('hidden');
          themeToggleDarkIcon?.classList.remove('hidden');
        }
      }

      updateIcons();

      themeToggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });
    </script>
  </body>
</html>
