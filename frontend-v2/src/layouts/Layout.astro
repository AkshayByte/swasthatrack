---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SwasthaTrack - Smart Healthcare Management & AI Triage',
  description = 'Next-generation healthcare management platform powered by AI triage and queue-priority suggestions for Ayushman Bharat Digital Mission (ABDM).'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Google Analytics (GA4) Placeholder -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SWSTHATRK0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SWSTHATRK0');
    </script>

    <!-- Prevent FOUC for Dark Mode -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-white">
    <!-- Global Header / Navbar -->
    <header class="sticky top-0 z-50 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white font-bold text-xl shadow-md group-hover:shadow-cyan-500/25 transition-all">
            ST
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-lg text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
              SwasthaTrack
              <span class="text-xs px-2 py-0.5 rounded-full bg-cyan-100 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 font-medium border border-cyan-200 dark:border-cyan-800">v2.0</span>
            </span>
            <span class="text-xs text-slate-500 dark:text-slate-400">ABDM & AI-Powered Healthcare</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
          <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Home</a>
          <a href="/#features" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Features</a>
          <a href="/dashboard/doctor" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Dashboards</a>
          <a href="/about" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">About</a>
          <a href="/contact" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Dark Mode Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-cyan-600 dark:hover:text-cyan-400 transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500"
            aria-label="Toggle dark mode"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <a
            href="/dashboard/registration"
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-xl text-white bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 shadow-sm hover:shadow-cyan-500/20 transition-all"
          >
            Open Portal
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/50 backdrop-blur-sm transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white font-bold text-sm">
                ST
              </div>
              <span class="font-bold text-slate-900 dark:text-white">SwasthaTrack</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              AI-driven multi-department hospital workflows and Ayushman Bharat Digital Mission compliant health records.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">Departments</h4>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
              <li><a href="/dashboard/registration" class="hover:text-cyan-600 dark:hover:text-cyan-400">Registration & Triage</a></li>
              <li><a href="/dashboard/doctor" class="hover:text-cyan-600 dark:hover:text-cyan-400">Doctor Consultation</a></li>
              <li><a href="/dashboard/pharmacy" class="hover:text-cyan-600 dark:hover:text-cyan-400">Pharmacy Dispensation</a></li>
              <li><a href="/dashboard/lab" class="hover:text-cyan-600 dark:hover:text-cyan-400">Laboratory Orders</a></li>
              <li><a href="/dashboard/admin" class="hover:text-cyan-600 dark:hover:text-cyan-400">Admin Control Center</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">Platform</h4>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
              <li><a href="/#features" class="hover:text-cyan-600 dark:hover:text-cyan-400">AI Triage Engine</a></li>
              <li><a href="/about" class="hover:text-cyan-600 dark:hover:text-cyan-400">About SwasthaTrack</a></li>
              <li><a href="/contact" class="hover:text-cyan-600 dark:hover:text-cyan-400">Support & Contact</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3">Legal & Compliance</h4>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
              <li><a href="/privacy" class="hover:text-cyan-600 dark:hover:text-cyan-400">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-cyan-600 dark:hover:text-cyan-400">Terms of Service</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-4">
          <p>© {new Date().getFullYear()} SwasthaTrack Healthcare Platform. All rights reserved.</p>
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>FastAPI & AI Backend Connected</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Dark Mode Interactive Script -->
    <script>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

      function updateIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          themeToggleLightIcon?.classList.remove('hidden');
          themeToggleDarkIcon?.classList.add('hidden');
        } else {
          themeToggleLightIcon?.classList.add('hidden');
          themeToggleDarkIcon?.classList.remove('hidden');
        }
      }

      updateIcons();

      themeToggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });
    </script>
  </body>
</html>
