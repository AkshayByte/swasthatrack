---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Support - SwasthaTrack"
  description="Get in touch with SwasthaTrack for hospital onboarding, patient support, and ABDM clinical inquiries."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#11192e] p-8 sm:p-12 shadow-sm space-y-8">
      
      <div class="border-b border-slate-100 dark:border-slate-800 pb-6 text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400">Hospital & Patient Care Support</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-1">Get in Touch with SwasthaTrack</h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
          Connect with our clinical operations team for hospital deployments, emergency triage setup, or patient assistance.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Information Cards -->
        <div class="space-y-4">
          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 space-y-1">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Hospital Onboarding & Partnership</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Deploy SwasthaTrack in your clinic, PHC, or multi-specialty hospital.</p>
            <div class="pt-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400">onboarding@swasthatrack.org</div>
          </div>

          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 space-y-1">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">24/7 Clinical & Patient Helpdesk</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Immediate assistance for doctors, pharmacists, and patient inquiries.</p>
            <div class="pt-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400">care@swasthatrack.org • 1800-11-4477</div>
          </div>

          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 space-y-1">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">ABDM Compliance & Security</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Inquiries regarding ABHA integration and consent-based health data privacy.</p>
            <div class="pt-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400">privacy@swasthatrack.org</div>
          </div>
        </div>

        <!-- Interactive Contact Form -->
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received by our clinical support team.');">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Full Name *</label>
            <input
              type="text"
              required
              placeholder="e.g. Dr. Rajesh Sharma / Clinic Manager"
              class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Email Address *</label>
            <input
              type="email"
              required
              placeholder="contact@hospital.org"
              class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Facility Type / Subject</label>
            <select class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none">
              <option>Hospital OPD Deployment</option>
              <option>Primary Health Center (PHC) Onboarding</option>
              <option>AI Triage Consultation</option>
              <option>Patient Support Request</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Message *</label>
            <textarea
              rows="4"
              required
              placeholder="Tell us about your healthcare facility or inquiry..."
              class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 shadow-md transition-all cursor-pointer"
          >
            Submit Inquiry
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>
