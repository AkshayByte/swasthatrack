---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Support - SwasthaTrack"
  description="Contact SwasthaTrack healthcare operations team for hospital onboarding, clinical support, and ABDM integration assistance."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 sm:p-12 shadow-sm space-y-8">
      
      <div class="border-b border-slate-100 dark:border-slate-800 pb-6 text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400">Hospital Support & Inquiries</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-1">Get in Touch with SwasthaTrack</h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
          Connect with our clinical systems engineers for hospital deployments, ABDM gateway integration, or technical support.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Information Cards -->
        <div class="space-y-4">
          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Hospital Deployment Inquiries</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">For multi-facility enterprise rollouts and ABDM certification.</p>
            <div class="mt-3 text-xs font-semibold text-cyan-600 dark:text-cyan-400">enterprise@swasthatrack.org</div>
          </div>

          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">24/7 Clinical Helpdesk</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Real-time troubleshooting for active doctor and pharmacy consoles.</p>
            <div class="mt-3 text-xs font-semibold text-cyan-600 dark:text-cyan-400">support@swasthatrack.org • +91 (800) 123-4567</div>
          </div>

          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Open Source & Research</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Collaborate on AI symptom triage and public health informatics.</p>
            <div class="mt-3 text-xs font-semibold text-cyan-600 dark:text-cyan-400">research@swasthatrack.org</div>
          </div>
        </div>

        <!-- Interactive Contact Form -->
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Your inquiry has been submitted to the SwasthaTrack operations team.');">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Full Name *</label>
            <input
              type="text"
              required
              placeholder="Dr. Rajesh / Hospital Admin"
              class="w-full px-3.5 py-2 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Work Email Address *</label>
            <input
              type="email"
              required
              placeholder="name@hospital.org"
              class="w-full px-3.5 py-2 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Subject / Department</label>
            <select class="w-full px-3.5 py-2 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none">
              <option>Hospital Deployment & Onboarding</option>
              <option>AI Triage Model Inquiry</option>
              <option>ABDM Sandbox Integration</option>
              <option>Technical Issue / Bug Report</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Message *</label>
            <textarea
              rows="4"
              required
              placeholder="Please describe your hospital facility size or technical requirement..."
              class="w-full px-3.5 py-2.5 rounded-xl text-sm border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-cyan-500 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-4 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 shadow-md transition-all"
          >
            Submit Message
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>
