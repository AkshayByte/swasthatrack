---
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: 'Immediate triage',
    color: 'text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/50',
    desc: 'AI evaluates each patient\'s symptoms and vitals at check-in, so critical cases are never buried behind a routine appointment.'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`,
    title: 'Connected departments',
    color: 'text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50',
    desc: 'Doctors, pharmacists, and lab technicians work on a shared live stream. A prescription created in the consultation room appears at the pharmacy counter in seconds.'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    title: 'Standardised records',
    color: 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50',
    desc: 'Patient records follow open EMR standards. Patients access their prescriptions and lab results digitally — no physical copy needed.'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    title: 'Privacy by design',
    color: 'text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50',
    desc: 'Strict role-based access means a lab technician cannot see prescription notes and a pharmacist cannot view clinical diagnoses. Patient data is never used for advertising.'
  },
];

const team = [
  { initials: 'VS', name: 'Dr. Vikram Sethi', role: 'Lead Physician & Clinical Advisor', dept: 'Cardiology OPD' },
  { initials: 'PD', name: 'Pooja Deshmukh', role: 'Patient Intake & Triage Lead', dept: 'Registration Desk' },
  { initials: 'SV', name: 'Sunil Verma', role: 'Chief Pharmacist', dept: 'Central Pharmacy' },
  { initials: 'MI', name: 'Dr. Meenakshi Iyer', role: 'Head of Pathology', dept: 'Diagnostic Lab' },
];
---

<Layout
  title="About SwasthaTrack — Our Mission & How We Work"
  description="SwasthaTrack was built to eliminate the fragmentation in Indian hospital OPDs — connecting every department into one synchronized clinical workflow."
>

  <!-- ─── HERO ─── -->
  <section class="pt-16 pb-20 md:pt-20 md:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="section-label mb-4 block">Our mission</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        No patient should wait <br class="hidden sm:inline" />
        <span class="text-sky-600 dark:text-sky-400">because of paperwork.</span>
      </h1>
      <p class="mt-6 text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        SwasthaTrack was built out of a simple observation: in most Indian hospitals, a critical patient waits in the same queue as someone with a routine cold — because reception staff have no way to tell the difference quickly. Paper prescriptions get lost. Lab orders take hours to reach pathology.
      </p>
      <p class="mt-4 text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        We built a connected system that changes this — starting at the front desk.
      </p>
    </div>
  </section>

  <!-- ─── PROBLEM / SOLUTION ─── -->
  <section class="py-16 bg-white dark:bg-[#0a1020] border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Problem -->
        <div class="rounded-2xl border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20 p-8">
          <div class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 mb-3">The problem</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
            Fragmented, paper-driven OPDs
          </h3>
          <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            {[
              'Critical patients wait behind routine cases with no urgency sorting.',
              'Doctors write prescriptions on paper that pharmacists misread or lose.',
              'Lab test orders are carried physically between departments.',
              'Patients wait hours for printed reports that could be shared instantly.',
            ].map(item => (
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 text-rose-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Solution -->
        <div class="rounded-2xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/50 dark:bg-emerald-950/20 p-8">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-3">Our approach</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
            One platform, every department
          </h3>
          <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            {[
              'AI scores every patient at check-in — emergencies are elevated automatically.',
              'Doctors write digital prescriptions that appear at the pharmacy in real time.',
              'Lab requisitions are dispatched electronically the moment a doctor orders them.',
              'Patients access their reports and prescriptions on any device.',
            ].map(item => (
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 pt-4 border-t border-emerald-200 dark:border-emerald-900/40 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
            Result: Up to 65% faster consultations, fewer errors, less waiting.
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── FOUR PILLARS ─── -->
  <section class="py-20 bg-slate-50 dark:bg-[#070d1a]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="section-label">What we stand for</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-900 dark:text-white">
          Four principles we never compromise on
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {pillars.map(p => (
          <div class="flex items-start gap-4 p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${p.color}`} set:html={p.icon} />
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1.5">{p.title}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── CLINICAL TEAM ─── -->
  <section class="py-20 bg-white dark:bg-[#0a1020] border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="section-label">Clinical staff</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-900 dark:text-white">
          Meet the clinical team
        </h2>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto">
          Sign in with your hospital credentials to access your role-specific console.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {team.map(member => (
          <div class="flex items-center gap-4 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 text-white font-bold flex items-center justify-center text-sm flex-shrink-0">
              {member.initials}
            </div>
            <div>
              <div class="font-semibold text-slate-900 dark:text-white text-sm">{member.name}</div>
              <div class="text-xs text-sky-600 dark:text-sky-400 font-medium mt-0.5">{member.role}</div>
              <div class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">{member.dept}</div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── TECH STANDARDS ─── -->
  <section class="py-20 bg-slate-50 dark:bg-[#070d1a]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="section-label">Technical standards</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-900 dark:text-white">
          Built to interoperate with existing systems
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          { title: 'FHIR / HL7 Compatible', desc: 'Patient record structures follow international health informatics standards for interoperability with existing hospital systems.' },
          { title: 'Open EMR Architecture', desc: 'No vendor lock-in. The platform is open-source and self-hostable on any standard Linux server or cloud provider.' },
          { title: 'Offline-First Design', desc: 'Core workflows function during internet outages with local caching and automatic server sync when connectivity resumes.' },
        ].map(item => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div class="font-bold text-slate-900 dark:text-white text-sm mb-2">{item.title}</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="py-16 bg-white dark:bg-[#0a1020] border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h3 class="text-2xl font-bold text-slate-900 dark:text-white">Want to deploy SwasthaTrack at your facility?</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Reach out to our team. We'll help you configure it for your hospital's size and workflow.
      </p>
      <div class="pt-2 flex items-center justify-center gap-3">
        <a href="/contact" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-sky-600 hover:bg-sky-700 transition-colors shadow-sm">
          Contact us →
        </a>
        <a href="/login" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-sky-400 transition-colors">
          Access console
        </a>
      </div>
    </div>
  </section>

</Layout>
