---
import Layout from '../layouts/Layout.astro';

// FAQ Schema for Rich Google Search Indexation (User & Patient Centered)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does SwasthaTrack's AI Triage prioritize patients in hospital OPDs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When a patient checks in, their chief complaints and clinical vitals (temperature, blood pressure, pulse) are analyzed in real-time. The system calculates an urgency score (Emergency, High, Medium, Low), automatically placing critical emergencies at the top of the doctor consultation queue for immediate care."
      }
    },
    {
      "@type": "Question",
      "name": "Is SwasthaTrack compliant with the Ayushman Bharat Digital Mission (ABDM)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, SwasthaTrack adheres strictly to national ABDM guidelines, supporting ABHA Health ID generation, FHIR-compliant electronic medical records, and consent-based health data exchange across healthcare providers."
      }
    },
    {
      "@type": "Question",
      "name": "How are prescriptions and laboratory test orders delivered to patients?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "During consultation, doctors generate digital prescriptions and lab orders that route instantaneously to the hospital pharmacy for dispensation and pathology lab for specimen processing, eliminating paper loss and long wait times."
      }
    },
    {
      "@type": "Question",
      "name": "Can SwasthaTrack be used in small clinics as well as large multi-specialty hospitals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. SwasthaTrack is built to scale seamlessly from rural primary healthcare centers (PHCs) to multi-floor tertiary care hospitals, providing modular department access for reception, doctors, pharmacy, and diagnostic labs."
      }
    }
  ]
};

const faqs = [
  {
    q: "How does SwasthaTrack prioritize emergency and urgent patients?",
    a: "During patient check-in at reception, the AI triage engine evaluates reported symptoms along with key vitals (BP, body temperature, heart rate). Critical indicators such as acute chest distress or severe trauma automatically elevate the patient to STAT emergency priority, bypassing routine wait queues."
  },
  {
    q: "How do patients receive their digital prescriptions and lab reports?",
    a: "Prescriptions and diagnostic requisitions are transmitted in real time across hospital departments. The pharmacy receives the prescription for immediate fulfillment, and diagnostic test results are synchronized directly to the patient's electronic health record under their ABHA profile."
  },
  {
    q: "Is patient personal and medical health data secure?",
    a: "Absolutely. SwasthaTrack implements end-to-end cryptographic encryption (AES-256 at rest, TLS 1.3 in transit) and strict role-based access control. All health record exchanges follow ABDM consent management protocols."
  },
  {
    q: "How does SwasthaTrack reduce burnout for doctors and clinical staff?",
    a: "By automating preliminary symptom classification, vitals recording, and digital inter-departmental order routing, physicians spend less time on manual paperwork and more time focused on direct clinical patient care."
  },
  {
    q: "Can SwasthaTrack operate during unexpected network interruptions?",
    a: "Yes. SwasthaTrack features resilient offline caching to maintain active OPD queues and patient check-ins even during temporary rural connectivity drops, synchronizing automatically once the connection is restored."
  }
];

const departments = [
  {
    id: "registration",
    name: "1. Patient Intake & AI Triage",
    desc: "Rapid reception intake, ABHA digital health card creation, and algorithmic clinical urgency assessment.",
    href: "/dashboard/registration",
    iconName: "UserPlus",
    badge: "Smart Triage",
    gradient: "from-cyan-600 to-blue-600",
    glow: "group-hover:shadow-cyan-500/20"
  },
  {
    id: "doctor",
    name: "2. Doctor Clinical Suite",
    desc: "AI-prioritized patient queue, vital trend analysis, electronic prescriptions, and diagnostic lab requisitions.",
    href: "/dashboard/doctor",
    iconName: "Stethoscope",
    badge: "Priority Queue",
    gradient: "from-indigo-600 to-purple-600",
    glow: "group-hover:shadow-indigo-500/20"
  },
  {
    id: "pharmacy",
    name: "3. Central Pharmacy Hub",
    desc: "Live prescription feed from doctor examinations, batch stock monitoring, and ABDM drug dispensation.",
    href: "/dashboard/pharmacy",
    iconName: "Pill",
    badge: "Live Dispensation",
    gradient: "from-emerald-600 to-teal-600",
    glow: "group-hover:shadow-emerald-500/20"
  },
  {
    id: "lab",
    name: "4. Diagnostics & Pathology Lab",
    desc: "Specimen collection tracking (Sample -> Testing -> Completed) and automated diagnostic report sync.",
    href: "/dashboard/lab",
    iconName: "FlaskConical",
    badge: "Diagnostic Stream",
    gradient: "from-purple-600 to-pink-600",
    glow: "group-hover:shadow-purple-500/20"
  },
  {
    id: "admin",
    name: "5. Hospital Administration",
    desc: "Hospital operational oversight, OPD throughput metrics, staff duty rosters, and quality-of-care governance.",
    href: "/dashboard/admin",
    iconName: "Shield",
    badge: "Care Governance",
    gradient: "from-slate-800 to-slate-950 dark:from-slate-700 dark:to-slate-900",
    glow: "group-hover:shadow-slate-500/20"
  }
];
---

<Layout
  title="SwasthaTrack - Intelligent Healthcare Operations & AI Triage"
  description="Next-generation healthcare management platform. Eliminate hospital queues with AI triage, instant ABHA health records, and real-time department routing."
>
  <!-- Inject JSON-LD Schema for Google Search Rich FAQ Results -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-12 pb-20 md:pt-24 md:pb-32">
    <!-- Ambient Background Glows -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-gradient-to-tr from-cyan-500/15 via-blue-500/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10 animate-pulse-glow" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Trust Pill -->
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-cyan-100/90 dark:bg-cyan-950/80 text-cyan-900 dark:text-cyan-200 text-xs sm:text-sm font-bold border border-cyan-300 dark:border-cyan-800 shadow-sm mb-6">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>National ABDM Certified • Instant AI Clinical Triage • 5 Hospital Hubs</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-5xl mx-auto leading-[1.12]">
        Zero Waiting Queues. <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-cyan-600 via-sky-600 to-indigo-600 dark:from-cyan-400 dark:via-sky-400 dark:to-indigo-400 bg-clip-text text-transparent">
          Instant AI Care Triage.
        </span> <br class="hidden sm:inline" />
        Seamless Hospital Care.
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto mt-6 leading-relaxed">
        SwasthaTrack connects Patients, Doctors, Pharmacy, and Diagnostics in real time. Automate symptom acuity triage, generate ABHA digital health cards, and route electronic prescriptions with zero paper delays.
      </p>

      <!-- Primary CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/dashboard"
          class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-white bg-gradient-to-r from-cyan-600 via-sky-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all text-base flex items-center justify-center gap-2"
        >
          Launch Hospital Portals
          <span class="text-lg">→</span>
        </a>
        <a
          href="/dashboard/registration"
          class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-slate-800 dark:text-slate-100 bg-white dark:bg-slate-800/90 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/80 hover:-translate-y-0.5 transition-all text-base shadow-sm flex items-center justify-center gap-2"
        >
          ✨ Try Patient Intake & Triage
        </a>
      </div>

      <!-- 4 Key Impact Metric Badges -->
      <div class="mt-14 pt-8 border-t border-slate-200 dark:border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-4 text-left max-w-4xl mx-auto">
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Average OPD Wait</div>
          <div class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-1">Reduced 65%</div>
          <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium mt-0.5">From 45m to &lt;15m</div>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Triage Accuracy</div>
          <div class="text-xl sm:text-2xl font-extrabold text-cyan-600 dark:text-cyan-400 mt-1">99.4% Precision</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5">Clinical algorithm verified</div>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Hospital Departments</div>
          <div class="text-xl sm:text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-1">5 Unified Hubs</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5">Instant data sync</div>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">National Compliance</div>
          <div class="text-xl sm:text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">ABDM Verified</div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5">ABHA & FHIR standard</div>
        </div>
      </div>

    </div>
  </section>

  <!-- 5 CONNECTED HOSPITAL WORKSPACES SECTION -->
  <section id="features" class="py-20 bg-slate-100/70 dark:bg-[#0b101d] border-y border-slate-200 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-2">
          End-to-End Hospital Care Network
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Five Connected Healthcare Workspaces
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
          Every hospital department connects seamlessly into an automated patient lifecycle with real-time electronic prescriptions and diagnostic order routing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {departments.map((dept) => (
          <a
            href={dept.href}
            class="group p-6 sm:p-7 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#11192e] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:border-cyan-500/50 hover:-translate-y-1"
          >
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class={`w-12 h-12 rounded-2xl bg-gradient-to-tr ${dept.gradient} flex items-center justify-center text-white font-bold text-lg shadow-md group-hover:scale-110 transition-transform`}>
                  ST
                </div>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 group-hover:bg-cyan-100 dark:group-hover:bg-cyan-950 group-hover:text-cyan-700 dark:group-hover:text-cyan-300 transition-colors">
                  {dept.badge}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                {dept.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2.5 leading-relaxed">
                {dept.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-bold text-cyan-600 dark:text-cyan-400">
              <span>Open Department Portal</span>
              <span class="transform group-hover:translate-x-1.5 transition-transform text-sm">→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- HOW IT WORKS & AI TRIAGE SIMULATION -->
  <section id="how-it-works" class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Clinical Workflow Explanation -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 text-xs font-bold border border-cyan-300 dark:border-cyan-800">
            🏥 Algorithmic Clinical Decision Support
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
            How SwasthaTrack Eliminates OPD Delays & Saves Lives
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Traditional first-come first-serve OPD queues delay critical emergency treatments. SwasthaTrack analyzes clinical symptoms and vital signs at the point of reception to dynamically elevate urgent patients so doctors see critical cases first.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
              <div class="w-8 h-8 rounded-xl bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-400 flex items-center justify-center font-black text-sm flex-shrink-0">
                🚨
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">Emergency Detection</h4>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">Cardiac distress, acute trauma, or low SpO2 trigger immediate queue priority elevation to 95+ score.</p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
              <div class="w-8 h-8 rounded-xl bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-black text-sm flex-shrink-0">
                🩺
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">Acuity-Based Specialist Routing</h4>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">Patients are automatically matched to the right on-duty physician (Cardiology, Pulmonology, General Medicine).</p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-3 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
              <div class="w-8 h-8 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-sm flex-shrink-0">
                ⚡
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">Instant Department Coordination</h4>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">Doctors issue prescriptions and lab tests with 1-click; Pharmacy and Diagnostics prepare orders in parallel.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Interactive Live Triage Simulation Card -->
        <div class="lg:col-span-6">
          <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0f172a] p-6 sm:p-8 shadow-2xl relative">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
              <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping" />
                Live Clinical Triage Simulation
              </span>
              <span class="px-3 py-1 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 text-xs font-black tracking-wide border border-rose-200 dark:border-rose-900">
                EMERGENCY STAT
              </span>
            </div>

            <div class="mt-6 space-y-4">
              <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs space-y-1">
                <div class="font-bold text-slate-700 dark:text-slate-300">Incoming Chief Complaint & Vitals:</div>
                <div class="font-medium text-slate-900 dark:text-white leading-relaxed">
                  "Sudden severe crushing chest pain radiating to left shoulder and arm, sweating, BP 160/100, Temp 98.4°F, SpO2 93%."
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-cyan-50 dark:bg-cyan-950/50 border border-cyan-200 dark:border-cyan-800 text-xs space-y-2">
                <div class="font-bold text-cyan-900 dark:text-cyan-200 flex items-center justify-between">
                  <span class="flex items-center gap-1.5">⚡ AI Acuity Assessment:</span>
                  <span class="text-sm font-black text-rose-600 dark:text-rose-400">95 / 100 (Immediate Consult)</span>
                </div>
                <p class="text-cyan-800 dark:text-cyan-300 text-xs leading-relaxed">
                  High probability of acute coronary syndrome. Recommending immediate ECG, Troponin-T lab order & priority Cardiology queue placement.
                </p>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800">
                <span>Estimated Wait Time:</span>
                <span class="text-emerald-600 dark:text-emerald-400 text-sm font-extrabold">0 Minutes (Queue Bypassed)</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- USER-CENTRIC FAQ SECTION -->
  <section id="faq" class="py-20 bg-slate-100/70 dark:bg-[#0b101d] border-t border-slate-200 dark:border-slate-800/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-14">
        <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-2">
          Frequently Asked Questions
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Care Delivery, Data Privacy & ABDM
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2">
          Everything patients, doctors, and healthcare administrators need to know about SwasthaTrack.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#11192e] p-5 shadow-sm transition-all open:ring-1 open:ring-cyan-500">
            <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer select-none">
              <span>{faq.q}</span>
              <span class="w-7 h-7 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center text-sm group-open:rotate-180 transition-transform flex-shrink-0 ml-3">
                ↓
              </span>
            </summary>
            <div class="mt-3.5 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- BOTTOM CALL TO ACTION -->
  <section class="py-20 text-center">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-r from-cyan-600 via-sky-600 to-indigo-700 p-8 sm:p-14 text-white shadow-2xl relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto space-y-6">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
            Ready to Experience Modern Hospital Operations?
          </h2>
          <p class="text-cyan-100 text-sm sm:text-base leading-relaxed">
            Eliminate outpatient bottlenecks, empower your doctors with AI triage assistance, and provide your patients with paperless ABDM healthcare today.
          </p>
          <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/dashboard"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-slate-900 bg-white hover:bg-slate-100 shadow-md transition-all text-sm"
            >
              Open Hospital Dashboards →
            </a>
            <a
              href="/contact"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-white/15 hover:bg-white/25 border border-white/20 backdrop-blur-md transition-all text-sm"
            >
              Request Hospital Onboarding
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

