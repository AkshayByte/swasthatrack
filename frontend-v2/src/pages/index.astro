---
import Layout from '../layouts/Layout.astro';

// FAQ Schema for Rich Google Search indexation
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does SwasthaTrack's AI triage automate queue prioritization?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SwasthaTrack utilizes intelligent symptom analysis powered by clinical algorithms and Google Gemini AI. When a patient checks in, their chief complaints and vitals are analyzed in real-time to compute urgency levels (Emergency, High, Medium, Low), automatically positioning critical cases at the top of the doctor consultation queue."
      }
    },
    {
      "@type": "Question",
      "name": "Is SwasthaTrack compliant with Ayushman Bharat Digital Mission (ABDM)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, SwasthaTrack adheres to national ABDM guidelines, facilitating automated ABHA Health ID creation, secure FHIR health data exchange, and end-to-end patient consent management."
      }
    },
    {
      "@type": "Question",
      "name": "How are prescriptions and lab orders routed between hospital departments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "During consultation, doctors create digital prescriptions and diagnostic test requisitions. These orders are instantly transmitted via high-speed REST APIs to the Pharmacy and Laboratory dashboards with real-time stock and specimen verification."
      }
    },
    {
      "@type": "Question",
      "name": "Why migrate SwasthaTrack to an Astro Multi-Page Application (MPA)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Astro provides sub-50ms Time-To-First-Byte (TTFB) and perfect Lighthouse SEO scores by rendering static HTML for public pages while hydrating rich React dashboards as isolated client islands on demand."
      }
    }
  ]
};

const faqs = [
  {
    q: "How does SwasthaTrack's AI triage automate queue prioritization?",
    a: "When patients check in at registration, their chief complaints, temperature, blood pressure, and symptom descriptions are analyzed in real-time. The system calculates an urgency score (Emergency, High, Medium, Low) and dynamically reorganizes the doctor's queue so critical cases receive immediate clinical attention."
  },
  {
    q: "Is SwasthaTrack compliant with Ayushman Bharat Digital Mission (ABDM)?",
    a: "Yes. SwasthaTrack incorporates ABHA ID generation, consent-based medical records exchange, and FHIR standard compliant health data structures across all 5 hospital departments."
  },
  {
    q: "How does inter-departmental order routing work?",
    a: "When a doctor finishes an examination, prescribed medications are instantly transmitted to the central Pharmacy dashboard for dispensation, and diagnostic requisitions are routed to the Laboratory for specimen collection and testing."
  },
  {
    q: "What advantages does the Astro MPA architecture provide?",
    a: "Traditional React SPAs send heavy JavaScript bundles to every visitor. Astro pre-renders pure HTML for instant loading, top-tier SEO discoverability, and zero initial runtime overhead, while hydrating interactive dashboard features as lightweight React islands."
  },
  {
    q: "Can SwasthaTrack work with local offline fallback?",
    a: "Yes. In case of network downtime or offline deployment in rural clinics, the system preserves patient queue states and records in local storage with automatic synchronization upon reconnection."
  }
];

const departments = [
  {
    name: "1. Registration & AI Triage",
    desc: "Rapid patient intake, ABHA registry generation, and automated clinical priority scoring.",
    href: "/dashboard/registration",
    icon: "UserPlus",
    color: "from-cyan-600 to-blue-600",
    badge: "AI Powered"
  },
  {
    name: "2. Doctor Consultation",
    desc: "Urgency-sorted consultation queue, vital statistics analysis, and direct order transmission.",
    href: "/dashboard/doctor",
    icon: "Stethoscope",
    color: "from-indigo-600 to-purple-600",
    badge: "Prioritized Queue"
  },
  {
    name: "3. Pharmacy Dispensation",
    desc: "Live prescription feed from doctors, stock batch tracking, and ABDM drug fulfillment.",
    href: "/dashboard/pharmacy",
    icon: "Pill",
    color: "from-emerald-600 to-teal-600",
    badge: "Stock Audited"
  },
  {
    name: "4. Diagnostic Laboratory",
    desc: "Specimen tracking stages (Sample -> Analysis -> Completed) with clinical findings logging.",
    href: "/dashboard/lab",
    icon: "FlaskConical",
    color: "from-purple-600 to-pink-600",
    badge: "Pathology Stream"
  },
  {
    name: "5. Admin & Telemetry",
    desc: "Hospital operational metrics, staff access controls, and FastAPI health telemetry.",
    href: "/dashboard/admin",
    icon: "Shield",
    color: "from-slate-800 to-slate-950",
    badge: "Telemetry & Logs"
  }
];
---

<Layout
  title="SwasthaTrack v2.0 - AI Healthcare Operations & Triage Platform"
  description="Next-generation multi-department hospital management platform featuring AI symptom triage, ABDM compliance, and sub-50ms Astro MPA performance."
>
  <!-- Inject JSON-LD Schema for Google Search Rich FAQ Results -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32">
    <!-- Ambient Glow Backdrops -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-cyan-500/15 via-blue-500/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10" />
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Top Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-100/80 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 text-xs sm:text-sm font-semibold border border-cyan-300 dark:border-cyan-800 shadow-sm mb-6 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>Astro Multi-Page Architecture • AI Triage Triage Engine • ABDM Compliant</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-5xl mx-auto leading-[1.15]">
        Intelligent Hospital Operations Powered by <span class="bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent">AI Triage</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto mt-6 leading-relaxed">
        Eliminate outpatient bottlenecks with automated clinical symptom triage, instant ABHA registry intake, and real-time order routing across Doctor, Pharmacy, and Diagnostics.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/dashboard"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600 hover:from-cyan-700 hover:to-indigo-700 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all text-base"
        >
          Launch Operations Portal →
        </a>
        <a
          href="/dashboard/registration"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 hover:-translate-y-0.5 transition-all text-base shadow-sm"
        >
          Try AI Patient Triage
        </a>
      </div>

      <!-- Feature Badges -->
      <div class="mt-12 pt-8 border-t border-slate-200/60 dark:border-slate-800/60 grid grid-cols-2 md:grid-cols-4 gap-4 text-left max-w-4xl mx-auto">
        <div class="p-3 rounded-xl bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200/60 dark:border-slate-800/60">
          <div class="text-xs text-slate-500 dark:text-slate-400">Queue Latency</div>
          <div class="text-lg font-bold text-slate-900 dark:text-white mt-0.5">&lt; 15 mins</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200/60 dark:border-slate-800/60">
          <div class="text-xs text-slate-500 dark:text-slate-400">Page Load (TTFB)</div>
          <div class="text-lg font-bold text-cyan-600 dark:text-cyan-400 mt-0.5">&lt; 50ms</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200/60 dark:border-slate-800/60">
          <div class="text-xs text-slate-500 dark:text-slate-400">Hospital Departments</div>
          <div class="text-lg font-bold text-slate-900 dark:text-white mt-0.5">5 Specialized Hubs</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-50/50 dark:bg-slate-800/30 border border-slate-200/60 dark:border-slate-800/60">
          <div class="text-xs text-slate-500 dark:text-slate-400">Compliance Standard</div>
          <div class="text-lg font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">ABDM Certified</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 DEPARTMENT HUBS SECTION -->
  <section id="features" class="py-16 bg-slate-50/60 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-2">
          End-to-End Clinical Lifecycle
        </h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Five Seamless Hospital Workspaces
        </p>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-3">
          Every hospital department connects seamlessly into a centralized queue with automated prescription and laboratory diagnostic order routing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {departments.map((dept) => (
          <a
            href={dept.href}
            class="group p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:border-cyan-500/50 hover:-translate-y-1"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class={`w-12 h-12 rounded-xl bg-gradient-to-tr ${dept.color} flex items-center justify-center text-white font-bold text-lg shadow-md group-hover:scale-110 transition-transform`}>
                  ST
                </div>
                <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                  {dept.badge}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                {dept.name}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
                {dept.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-bold text-cyan-600 dark:text-cyan-400">
              <span>Open Dashboard Island</span>
              <span class="transform group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AI TRIAGE HOW IT WORKS SECTION -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-100 dark:bg-cyan-950 text-cyan-800 dark:text-cyan-300 text-xs font-bold">
            Algorithmic Clinical Decision Support
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            How SwasthaTrack AI Triage Prevents ER Overcrowding
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Traditional first-come first-serve OPD queues delay critical emergency treatments. SwasthaTrack evaluates patient vitals and symptom severity at the point of registration to dynamically elevate urgent patients without manual doctor reassignment.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                !
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">Emergency Detection</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Cardiac distress, acute trauma, or low SpO2 trigger immediate queue priority score elevation to 95+.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                ▲
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">Acuity Routing</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Patients are automatically matched to specialized consultants (Cardiology, Pulmonology, Internal Medicine).</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                ✓
              </div>
              <div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white">FastAPI Sync</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">All decisions are committed to PostgreSQL database with complete auditable provenance for compliance.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <!-- Interactive Visual Mockup Card -->
          <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-2xl relative">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Live AI Triage Simulation</span>
              <span class="px-2.5 py-0.5 rounded-full bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 text-xs font-bold animate-pulse">
                EMERGENCY PRIORITY
              </span>
            </div>

            <div class="mt-6 space-y-4">
              <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs">
                <div class="font-bold text-slate-700 dark:text-slate-200 mb-1">Incoming Chief Complaint:</div>
                <div class="font-mono text-slate-900 dark:text-white">"Sudden severe crushing chest pain radiating to left shoulder and jaw, profuse sweating, BP 160/100, Temp 98.4°F."</div>
              </div>

              <div class="p-4 rounded-xl bg-cyan-50/80 dark:bg-cyan-950/40 border border-cyan-200 dark:border-cyan-900 text-xs space-y-2">
                <div class="font-bold text-cyan-900 dark:text-cyan-200 flex items-center justify-between">
                  <span>Gemini AI Acuity Score:</span>
                  <span class="text-sm font-mono font-bold text-rose-600 dark:text-rose-400">95 / 100 (STAT)</span>
                </div>
                <p class="text-cyan-800 dark:text-cyan-300 text-[11px]">
                  Critical myocardial infarction markers detected. Recommending immediate ECG, Troponin-T lab order & Cardiology priority bypass.
                </p>
              </div>

              <div class="pt-2 flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300">
                <span>Queue Wait Estimation:</span>
                <span class="text-emerald-600 dark:text-emerald-400">0 Minutes (Immediate Consult)</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SEO-OPTIMIZED FAQ SECTION -->
  <section class="py-20 bg-slate-50/60 dark:bg-slate-900/40 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-2">
          Frequently Asked Questions
        </h2>
        <p class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Healthcare Data, AI Triage & ABDM Compliance
        </p>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
          Everything you need to know about SwasthaTrack's architecture, security, and hospital deployment.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm transition-all open:ring-1 open:ring-cyan-500">
            <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-900 dark:text-white cursor-pointer select-none">
              <span>{faq.q}</span>
              <span class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center text-sm group-open:rotate-180 transition-transform">
                ↓
              </span>
            </summary>
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM CALL TO ACTION -->
  <section class="py-20 text-center">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-700 p-8 sm:p-12 text-white shadow-2xl relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto space-y-6">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
            Ready to Modernize Your Hospital Operations?
          </h2>
          <p class="text-cyan-100 text-sm sm:text-base leading-relaxed">
            Experience sub-second triage allocation, ABDM compliant digital prescriptions, and lightning-fast Astro MPA performance today.
          </p>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/dashboard"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-slate-900 bg-white hover:bg-slate-100 shadow-md transition-all text-sm"
            >
              Open Unified Operations Dashboard
            </a>
            <a
              href="/about"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md transition-all text-sm"
            >
              Read Architecture Overview
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
