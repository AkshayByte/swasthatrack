---
import Layout from '../layouts/Layout.astro';
import InteractiveClinicalSimulator from '../components/react/InteractiveClinicalSimulator';

const departments = [
  {
    id: 'registration',
    num: '01',
    name: 'Registration & Triage',
    desc: 'Check in patients, collect vitals, and get AI-assisted urgency scoring in under 2 minutes.',
    href: '/dashboard/registration',
    tag: 'Patient Intake',
    color: 'text-cyan-600 dark:text-cyan-400',
    ring: 'ring-cyan-200 dark:ring-cyan-900',
    bg: 'bg-cyan-50 dark:bg-cyan-950/40',
  },
  {
    id: 'doctor',
    num: '02',
    name: 'Doctor Consultation',
    desc: 'Work through a prioritized queue. Record notes, issue e-prescriptions, and order lab tests from one screen.',
    href: '/dashboard/doctor',
    tag: 'Physician Suite',
    color: 'text-blue-600 dark:text-blue-400',
    ring: 'ring-blue-200 dark:ring-blue-900',
    bg: 'bg-blue-50 dark:bg-blue-950/40',
  },
  {
    id: 'pharmacy',
    num: '03',
    name: 'Pharmacy & Inventory',
    desc: 'Prescriptions arrive the moment a doctor submits them. Dispense, track stock, and flag expiring medicines.',
    href: '/dashboard/pharmacy',
    tag: 'Central Pharmacy',
    color: 'text-emerald-600 dark:text-emerald-400',
    ring: 'ring-emerald-200 dark:ring-emerald-900',
    bg: 'bg-emerald-50 dark:bg-emerald-950/40',
  },
  {
    id: 'lab',
    num: '04',
    name: 'Pathology & Lab',
    desc: 'Lab requisitions flow in automatically. Track samples from collection to result, then publish verified reports.',
    href: '/dashboard/lab',
    tag: 'Diagnostics',
    color: 'text-purple-600 dark:text-purple-400',
    ring: 'ring-purple-200 dark:ring-purple-900',
    bg: 'bg-purple-50 dark:bg-purple-950/40',
  },
  {
    id: 'admin',
    num: '05',
    name: 'Administration',
    desc: 'Monitor throughput across all departments, manage staff roles, and review clinical audit logs.',
    href: '/dashboard/admin',
    tag: 'Governance',
    color: 'text-slate-600 dark:text-slate-400',
    ring: 'ring-slate-200 dark:ring-slate-700',
    bg: 'bg-slate-50 dark:bg-slate-800/40',
  },
];

const stats = [
  { value: '< 2 min', label: 'Patient check-in time', sub: 'vs 15–20 min paper-based' },
  { value: '5', label: 'Connected departments', sub: 'Unified on one platform' },
  { value: 'Real-time', label: 'Prescription routing', sub: 'Doctor → Pharmacy instantly' },
  { value: 'AI-first', label: 'Emergency triage', sub: 'Gemini + ESI heuristics' },
];

const faqs = [
  {
    q: 'Does it work when the internet goes down?',
    a: 'Yes. SwasthaTrack uses client-side caching so reception staff can continue registering patients during network outages. Data reconciles automatically when connectivity is restored — critical for rural and semi-urban clinics.'
  },
  {
    q: 'How does AI triage decide who gets seen first?',
    a: 'When a patient checks in, their symptoms and vitals (temperature, blood pressure, SpO2, heart rate) are scored using Google Gemini and a clinical severity algorithm based on the Emergency Severity Index. High-risk patients are automatically elevated to the top of the doctor\'s queue.'
  },
  {
    q: 'Does a pharmacist have to wait for a paper prescription?',
    a: 'No. The moment a doctor finalizes a consultation, the prescription appears in the pharmacy queue. The pharmacist can begin preparing the order before the patient even leaves the doctor\'s room.'
  },
  {
    q: 'Is patient data secure?',
    a: 'All sessions are authenticated with JWT tokens and protected by role-based access control. A pharmacist cannot see doctor notes; a lab technician cannot see prescription details. Data is encrypted at rest and in transit.'
  },
];
---

<Layout
  title="SwasthaTrack — Hospital Workflow & OPD Management Platform"
  description="SwasthaTrack connects patient registration, doctor consultations, pharmacy, and lab diagnostics into one synchronized workflow. Built for Indian hospitals."
>

  <!-- ─── HERO ─── -->
  <section class="relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28">
    <!-- Soft radial glow -->
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-sky-400/8 dark:bg-sky-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <!-- Live status pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 shadow-sm text-xs font-medium text-slate-600 dark:text-slate-300 mb-8 animate-fade-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Live demo — all 5 clinical consoles active
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-[4.25rem] font-extrabold tracking-tight text-slate-900 dark:text-white max-w-3xl mx-auto animate-fade-in-up" style="line-height:1.1;">
        Hospital operations,<br />
        <span class="text-sky-600 dark:text-sky-400">finally connected.</span>
      </h1>

      <!-- Subline -->
      <p class="mt-6 text-lg sm:text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto font-normal leading-relaxed animate-fade-in-up delay-100">
        From the moment a patient walks in to when they receive their prescription — SwasthaTrack keeps every department synchronized, automatically.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 animate-fade-in-up delay-200">
        <a
          href="/dashboard"
          id="hero-open-dashboard"
          class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-sm text-white bg-sky-600 hover:bg-sky-700 shadow-md hover:shadow-sky-500/25 transition-all hover:-translate-y-0.5"
        >
          Open all 5 consoles →
        </a>
        <a
          href="#how-it-works"
          id="hero-see-how"
          class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-sm text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-all hover:-translate-y-0.5"
        >
          See how it works
        </a>
      </div>

      <!-- Stats strip -->
      <div class="mt-14 pt-10 border-t border-slate-200 dark:border-slate-800 grid grid-cols-2 md:grid-cols-4 gap-5 text-left animate-fade-in-up delay-300">
        {stats.map(stat => (
          <div class="space-y-1">
            <div class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">{stat.value}</div>
            <div class="text-sm font-medium text-slate-700 dark:text-slate-300">{stat.label}</div>
            <div class="text-xs text-slate-400 dark:text-slate-500">{stat.sub}</div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── HOW IT WORKS ─── -->
  <section id="how-it-works" class="py-20 bg-white dark:bg-[#0a1020] border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-14">
        <span class="section-label">End-to-end workflow</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
          One patient. Five departments. Zero paper.
        </h2>
        <p class="mt-4 text-slate-500 dark:text-slate-400 max-w-xl mx-auto text-sm leading-relaxed">
          A visit that used to involve paperwork, waiting, and miscommunication now flows as a single connected digital thread.
        </p>
      </div>

      <!-- Steps timeline -->
      <div class="relative">
        <!-- Connecting line -->
        <div class="hidden md:block absolute top-8 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-slate-200 dark:via-slate-700 to-transparent"></div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6 md:gap-4 relative">
          {[
            { n: 1, icon: '👤', step: 'Check-in', who: 'Reception staff', desc: 'Patient walks in. Staff logs their details and vitals in under 2 minutes.' },
            { n: 2, icon: '🧠', step: 'AI Triage', who: 'Automated', desc: 'Symptoms are scored. Emergencies move to the front of the queue instantly.' },
            { n: 3, icon: '🩺', step: 'Consultation', who: 'Doctor', desc: 'Doctor reviews AI priority queue, examines patient, writes e-prescription.' },
            { n: 4, icon: '💊', step: 'Dispensing', who: 'Pharmacist', desc: 'Prescription appears immediately. Medicine is prepared before the patient arrives.' },
            { n: 5, icon: '🔬', step: 'Lab Results', who: 'Lab Technician', desc: 'Test orders route to the lab. Results are published digitally — no paper lost.' },
          ].map(item => (
            <div class="flex flex-col items-center text-center gap-3">
              <div class="relative w-16 h-16 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-2xl shadow-sm flex-shrink-0">
                {item.icon}
                <span class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-sky-600 text-white text-[10px] font-bold flex items-center justify-center">
                  {item.n}
                </span>
              </div>
              <div>
                <div class="font-semibold text-slate-900 dark:text-white text-sm">{item.step}</div>
                <div class="text-[11px] text-sky-600 dark:text-sky-400 font-medium mt-0.5 mb-1.5">{item.who}</div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- ─── DEPARTMENTS ─── -->
  <section id="departments" class="py-20 bg-slate-50 dark:bg-[#070d1a]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="section-label">Role-based consoles</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
          Built for every person in the hospital
        </h2>
        <p class="mt-4 text-slate-500 dark:text-slate-400 text-sm max-w-lg mx-auto">
          Each department gets its own dedicated interface — purpose-built for that role's actual daily tasks.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {departments.map(dept => (
          <a
            href={dept.href}
            id={`dept-card-${dept.id}`}
            class="group flex flex-col p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-sky-300 dark:hover:border-sky-800 shadow-sm card-lift"
          >
            <div class="flex items-start justify-between mb-5">
              <div class={`w-10 h-10 rounded-xl ${dept.bg} ring-1 ${dept.ring} flex items-center justify-center`}>
                <span class={`text-sm font-bold font-mono ${dept.color}`}>{dept.num}</span>
              </div>
              <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${dept.bg} ${dept.color} border border-current/20`}>
                {dept.tag}
              </span>
            </div>
            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
              {dept.name}
            </h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">{dept.desc}</p>
            <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-1.5 text-xs font-semibold text-sky-600 dark:text-sky-400">
              <span>Open console</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── ARCHITECTURE PILLARS ─── -->
  <section class="py-20 bg-white dark:bg-[#0a1020] border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="md:grid md:grid-cols-2 md:gap-16 md:items-center">

        <div class="mb-10 md:mb-0">
          <span class="section-label">Under the hood</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
            Engineered for reliability, not just demos.
          </h2>
          <p class="mt-4 text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
            SwasthaTrack is built on production-grade infrastructure that handles concurrent users, network drops, and data integrity without compromising on speed.
          </p>
          <a href="/about" class="inline-flex items-center gap-1.5 mt-6 text-sm font-semibold text-sky-600 dark:text-sky-400 hover:underline underline-offset-4">
            Read the full architecture →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4">
          {[
            {
              title: 'Async AI Triage',
              desc: 'FastAPI\'s async pipeline evaluates vitals against Gemini without blocking patient registration — even when AI latency spikes, a clinical fallback runs in milliseconds.',
              icon: '🧠',
            },
            {
              title: 'Real-time Department Sync',
              desc: 'Prescriptions and lab orders reach pharmacy and pathology the instant a doctor saves them. No polling. No refresh.',
              icon: '⚡',
            },
            {
              title: 'Role-Based Access Control',
              desc: 'Strict RBAC ensures a pharmacist can only see prescriptions, a lab tech only lab orders — enforced at both the API and frontend layer.',
              icon: '🔒',
            },
            {
              title: 'Offline-Resilient',
              desc: 'Client-side state caching keeps registration and queue management functional during network outages, with automatic sync on reconnect.',
              icon: '📡',
            },
          ].map(item => (
            <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
              <span class="text-xl mt-0.5 shrink-0">{item.icon}</span>
              <div>
                <div class="font-semibold text-slate-900 dark:text-white text-sm">{item.title}</div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ─── INTERACTIVE SIMULATOR ─── -->
  <section id="simulator" class="py-20 bg-slate-50 dark:bg-[#070d1a]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="section-label">Live demo</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
          Try it yourself — no login needed.
        </h2>
        <p class="mt-4 text-slate-500 dark:text-slate-400 text-sm max-w-xl mx-auto">
          Pick a patient scenario and watch the full clinical flow from triage scoring to prescription routing play out in real time.
        </p>
      </div>

      <InteractiveClinicalSimulator client:visible />

    </div>
  </section>

  <!-- ─── FAQ ─── -->
  <section id="faq" class="py-20 bg-white dark:bg-[#0a1020] border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="section-label">Common questions</span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-900 dark:text-white">
          Things people ask before getting started
        </h2>
      </div>

      <div class="space-y-3" id="faq-list">
        {faqs.map((faq, i) => (
          <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold text-sm text-slate-900 dark:text-white cursor-pointer list-none select-none">
              <span>{faq.q}</span>
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-500 dark:text-slate-400 leading-relaxed border-t border-slate-200 dark:border-slate-800 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── FINAL CTA ─── -->
  <section class="py-20 bg-slate-50 dark:bg-[#070d1a]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <div class="rounded-2xl bg-slate-900 dark:bg-slate-800/60 dark:border dark:border-slate-700 p-10 sm:p-14 relative overflow-hidden">
        <div class="pointer-events-none absolute -top-20 -right-20 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl"></div>
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 dark:bg-slate-700/60 text-xs font-medium text-slate-300 border border-slate-700 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            All 5 clinical consoles ready
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Ready to run it at your hospital?
          </h2>
          <p class="mt-4 text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
            SwasthaTrack is open-source and self-hostable. Explore the live demo consoles with pre-loaded clinical data, or read the documentation to deploy it yourself.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/dashboard"
              id="cta-open-dashboard"
              class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-sm text-slate-900 bg-white hover:bg-slate-100 transition-colors shadow-sm"
            >
              Explore live demo →
            </a>
            <a
              href="/contact"
              id="cta-contact"
              class="w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-sm text-slate-300 bg-slate-800 dark:bg-slate-700/50 hover:bg-slate-700 border border-slate-700 transition-colors"
            >
              Talk to us
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>
