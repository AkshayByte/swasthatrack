---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SwasthaTrack v2.0 - Smart Healthcare Platform">
  <div class="relative overflow-hidden py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-6 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800 shadow-sm">
          <span>🚀 SwasthaTrack v2.0 Architecture Migration</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Intelligent Healthcare with <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600 dark:from-cyan-400 dark:to-blue-400">AI Triage</span> & Multi-Department Routing
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          High-performance Astro MPA frontend built for ABDM compliance, automated symptom-based triage, and seamless departmental coordination across Registration, Doctor, Pharmacy, Lab, and Admin.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
          <a
            href="/dashboard/registration"
            class="px-6 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-700 hover:to-blue-700 shadow-lg shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5"
          >
            Launch Patient Registration
          </a>
          <a
            href="/dashboard/doctor"
            class="px-6 py-3 rounded-xl font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 shadow-sm transition-all"
          >
            Doctor Queue
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
