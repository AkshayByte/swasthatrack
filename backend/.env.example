# .env.example for SwasthaTrack backend
# Copy this file to .env and fill in the appropriate values.

# ─── Database ──────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite:///./swasthatrack.db
# PostgreSQL for production (Render auto-populates this):
# DATABASE_URL=postgresql://user:pass@host:5432/swasthatrack

# ─── Authentication ────────────────────────────────────────
# JWT secret key (replace with a strong random value in production)
SECRET_KEY=your-very-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated origins. In production, set to your Vercel URL only.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# ─── Environment ───────────────────────────────────────────
# Set to "production" on Render (changes CORS behavior, disables debug logging)
ENVIRONMENT=development

# ─── Google Gemini AI Triage ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Google OAuth ──────────────────────────────────────────
# Google Client ID from Google Cloud Console (OAuth 2.0 Web Application)
GOOGLE_CLIENT_ID=
# Comma-separated emails that automatically receive 'admin' role upon Google Sign-In
SUPERADMIN_EMAILS=

# ─── Gunicorn (production only) ───────────────────────────
# WEB_CONCURRENCY=3
# PORT=8000
