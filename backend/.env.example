# .env.example for SwasthaTrack backend
# Copy this file to .env and fill in the appropriate values.

# Database URL (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./swasthatrack.db

# JWT secret key (replace with a strong random value in production)
SECRET_KEY=your-very-secret-key

# JWT token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allowed origins (comma separated). Use * for dev only.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ABDM API base URL (if used)
ABDM_API_URL=https://api.abdm.gov.in

# Environment (development / production)
ENVIRONMENT=development
